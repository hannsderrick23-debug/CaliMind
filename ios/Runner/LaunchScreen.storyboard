                    <view key="view" contentMode="scaleToFill" id="launch-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852" />
                        <color key="backgroundColor" red="0.0706" green="0.0863" blue="0.1216" alpha="1" colorSpace="custom" customColorSpace="sRGB" />
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="CaliMindLogo" translatesAutoresizingMaskIntoConstraints="NO" id="brand-logo">
